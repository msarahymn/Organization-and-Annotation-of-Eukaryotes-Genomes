#!/bin/bash
#SBATCH --job-name=UpdateGFF
#SBATCH --partition=pibu_el8
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --mail-user=maisyaroh.maisyaroh@students.unibe.ch
#SBATCH --mail-type=fail,end
#SBATCH --account=class-sbl-30004-ws-2026
#SBATCH --reservation=class-sbl-30004-2026-10-28
#SBATCH --output=/data/users/mmaisyaroh/genome_annotation_course/logs/UpdateGFF/UpdateGFF_%j.out
#SBATCH --error=/data/users/mmaisyaroh/genome_annotation_course/logs/UpdateGFF/UpdateGFF_%j.err

set -euo pipefail

COURSEDIR="/data/courses/genome_annotation_resources/2026"
WORKDIR="/data/users/mmaisyaroh/genome_annotation_course"
OUTDIR="$WORKDIR/output/MAKER"
FINALDIR="$OUTDIR/final"
MAKER_SIF="$COURSEDIR/containers/MAKER_3.01.03.sif"
gff="assembly.all.maker.noseq.gff"

mkdir -p "$FINALDIR/tmp"
cd "$FINALDIR"

apptainer exec --cleanenv --env TMPDIR=/tmp --bind "$OUTDIR/tmp":/tmp --bind "$COURSEDIR" \
    --bind "$WORKDIR" \
    --pwd "$FINALDIR" "$MAKER_SIF" \
    ipr_update_gff ${gff}.renamed.gff output.iprscan > ${gff}.renamed.iprscan.gff